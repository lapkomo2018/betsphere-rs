# Copy to .env and adjust. .env is gitignored; this file is the template.
# Read by both the app (dotenvy) and docker compose (env_file + interpolation).
# NOTE: don't use ${VAR} references here — dotenvy passes them through literally.

# --- App ---

# Address the HTTP server binds to.
# Docker compose overrides this to 0.0.0.0:8080 inside the container.
BIND_ADDR=127.0.0.1:8080

# Public base URL clients reach the API on; used to build absolute URLs
# (e.g. avatar links). Set to the real domain behind a proxy/HTTPS.
APP_URL=http://localhost:8080

# Log filter, read by tracing
RUST_LOG=info

# --- Auth ---

# Secret for signing HS256 access tokens. Required, no default.
# Generate a real one for anything beyond local dev:
#   openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me

# Token lifetimes in seconds (defaults: 15 min access, 30 days refresh)
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000

# Set the Secure flag on the refresh cookie. Enable in production (HTTPS).
COOKIE_SECURE=false

# --- Storage ---

# Directory uploaded files (avatars) are stored under.
# Relative paths resolve against the working directory the app runs from.
STORAGE_ROOT=storage

# --- CORS ---

# Comma-separated list of origins the browser frontend runs on.
# Cross-origin requests from these origins may send credentials (the refresh
# cookie). Use `*` to allow any origin WITHOUT credentials (dev only — the
# refresh cookie will not flow cross-origin in that mode).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
# The app assembles the connection URL from these parts.
# Values here are for native `cargo run` against the dockerized Postgres
# (dev setup); in the prod compose file HOST/PORT are overridden to
# postgres:5432 inside the network.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=betsphere
POSTGRES_PASSWORD=betsphere
POSTGRES_DB=betsphere

# Optional full override; when set it wins over the parts above
# (useful for managed hosting that hands out a single URL).
# DATABASE_URL=postgres://user:pass@host:5432/db

# --- Cache ---
# Redis, used as a read cache in front of Postgres. Same host/port convention
# as the database: these values fit native `cargo run` against the dockerized
# Redis; the prod compose file overrides HOST/PORT to redis:6379.

REDIS_HOST=localhost
REDIS_PORT=6379

# Optional full override; when set it wins over the parts above.
# REDIS_URL=redis://host:6379

# How long cached entries live, in seconds. Staleness after out-of-band
# writes is bounded by this value, so keep it short.
CACHE_TTL_SECS=60

# --- Demo mode ---
# A cast of bot accounts that keeps the platform looking inhabited: one of them
# opens and settles markets, the rest bet, chat and react. They drive the same
# use cases the API does, so everything they do shows up on the price charts,
# the bet feed and live WebSocket subscriptions.
#
# NEVER enable this against a real database. The bots write real rows, all of
# them share DEMO_BOT_PASSWORD, and the market maker holds the admin role.

DEMO_MODE=false

# Number of bot accounts, the market-making one included (max 17).
DEMO_BOTS=12

# Password every bot account is created with, so you can log in as one:
#   <name>@bots.betsphere.invalid — see the log line at startup.
DEMO_BOT_PASSWORD=demo-password

# How often something happens, in seconds. Each is jittered by ±40% so the
# loops don't fire in lockstep; lower them to make a demo look busier.
DEMO_CHAT_INTERVAL_SECS=15
DEMO_BET_INTERVAL_SECS=25
DEMO_MARKET_INTERVAL_SECS=300

# --- Demo mode: local model (optional) ---
# Point this at a local model server and the bots write their own messages,
# replies and reactions instead of drawing them from canned pools. They are
# shown the room: the market, its current prices, and the last few messages —
# so they answer real users too. Unset (the default) keeps the canned lines.
#
# Any server speaking the OpenAI chat-completions shape works. The full
# endpoint is expected, and it must be http:// — this talks to a server on the
# same machine, so the client is built without TLS.
#
#   make llm-up (dockerized)  -> http://localhost:11434/v1/chat/completions
#   ollama serve (installed)  -> http://localhost:11434/v1/chat/completions
#   llama-server --port 8081  -> http://localhost:8081/v1/chat/completions
#   LM Studio                 -> http://localhost:1234/v1/chat/completions
#
# In the dockerized stack the API reaches the model server by service name;
# compose rewrites this to http://ollama:11434/v1/chat/completions, so any
# non-empty value there means "on".
#
# DEMO_LLM_URL=http://localhost:11434/v1/chat/completions

# Model name as that server knows it — `make llm-up` downloads this one.
# The smallest one you have is the point: each call writes one sentence of
# small talk, and anything unusable falls back to a canned line. In order of
# "will run on anything" (names are Ollama library tags, ollama.com/library):
#   gemma3:270m     ~0.3 GB, terse and often odd
#   qwen2.5:0.5b    ~0.4 GB, the default — coherent enough for one line
#   llama3.2:1b     ~1.3 GB, noticeably better banter
#   qwen2.5:3b      ~1.9 GB, if the machine has room to spare
DEMO_LLM_MODEL=qwen2.5:0.5b

# How long a bot waits for a line before giving up and using a canned one.
# Nothing stalls: the turn just falls back. Raise it on a slow CPU — a 0.5B
# model answers in about a second, a 3B one can take several.
DEMO_LLM_TIMEOUT_SECS=10

# Host port the dockerized model server is published on (dev compose only).
OLLAMA_PORT=11434

# --- Docker compose ---

# Host port the API container is published on (prod compose only)
API_PORT=8080
